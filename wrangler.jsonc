{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-shortlink",
	"main": "src/index.js",
	"compatibility_date": "2026-10-23",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
		},
		"issues": {
			"enabled": true,
		},
	},
	"upload_source_maps": true,
	"placement": { "mode": "smart" },
	"cache": {
		"enabled": true,
	},
	"workers_dev": true,
	"preview_urls": false,
}
